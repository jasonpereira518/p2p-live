# Copy to .env.local and set your key. Never commit .env.local or any file containing real keys.
# Used only by the ops API server (server/index.js) for the Complaints LLM summary feature.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Ops API server port (default: 3001)
# OPS_API_PORT=3001


# Mapbox: client (tiles) and server (Directions API only)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
# Server-only; never expose. Used for /api/mapbox/route (Directions).
MAPBOX_TOKEN=your_mapbox_token_here

# No spaces around `=`. Leave empty locally so Vite proxies /api (avoids CORS).
# VITE_API_BASE_URL=https://p2p-live.onrender.com
VITE_API_BASE_URL=

# Dev-only: where Vite proxies /api when VITE_API_BASE_URL is empty.
# Use production while developing without a local API, or http://localhost:3001 for npm run server.
# VITE_API_PROXY_TARGET=https://p2p-live.onrender.com
# OPS_API_PORT=3001

# Optional: base URL for ops API (route proxy). Default same-origin.
# VITE_OPS_API_URL=http://localhost:3001

# GMV Syncromatics RTPI API key (server-only; never prefix with VITE_). Used by /api/live/*.
GMV_RTPI_API_KEY=

# Ops dashboards (P2P Login, admin/manager/driver pages) are off by default and left out
# of the build. Set this to build them in (frontend):
# VITE_ENABLE_OPS=true
# ...and this to serve their API endpoints (server: diagnostics, Gemini summaries):
# ENABLE_OPS_API=true
